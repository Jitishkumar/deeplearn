# Application Configuration
APP_NAME="AI-Powered DevOps Pipeline"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration
DATABASE_URL="sqlite:///./devops_pipeline.db"
# For PostgreSQL: postgresql://devops_user:devops_pass@localhost:5432/devops_pipeline
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (Optional - for caching)
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=False

# JWT Authentication
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI/ML Configuration
ML_MODEL_PATH="./ai-engine/models"
MODEL_RETRAIN_INTERVAL_HOURS=24
MIN_SAMPLES_FOR_TRAINING=100
PREDICTION_CONFIDENCE_THRESHOLD=0.7

# Pipeline Configuration
MAX_CONCURRENT_BUILDS=10
BUILD_TIMEOUT_MINUTES=30
LOG_RETENTION_DAYS=30
WORKSPACE_PATH="./workspaces"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Metrics & Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090
PROMETHEUS_ENABLED=False

# Email Notifications (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@devops-pipeline.com"
EMAIL_ENABLED=False

# Webhook Configuration
WEBHOOK_SECRET="webhook-secret-key"
WEBHOOK_TIMEOUT_SECONDS=10

# GitHub Integration (Optional)
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""

# Docker Configuration
DOCKER_HOST="unix:///var/run/docker.sock"
DOCKER_NETWORK="devops_network"

# Kubernetes Configuration (Optional)
K8S_ENABLED=False
K8S_NAMESPACE="devops-pipeline"
KUBECONFIG_PATH="~/.kube/config"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Feature Flags
ENABLE_AI_PREDICTIONS=True
ENABLE_AUTO_DEPLOY=False
ENABLE_WEBHOOKS=True
ENABLE_NOTIFICATIONS=False

# Testing
TEST_DATABASE_URL="sqlite:///./test_devops_pipeline.db"
